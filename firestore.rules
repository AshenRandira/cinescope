rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidOptionalText(value) {
      return value == null || value is string;
    }

    function hasValidResumeEpisode(episode) {
      return episode == null ||
        (episode is map &&
          episode.keys().hasAll([
            'episodeNumber',
            'name',
            'seasonNumber',
            'stillPath'
          ]) &&
          episode.keys().hasOnly([
            'episodeNumber',
            'name',
            'seasonNumber',
            'stillPath'
          ]) &&
          episode.episodeNumber is int &&
          episode.episodeNumber > 0 &&
          episode.seasonNumber is int &&
          episode.seasonNumber >= 0 &&
          episode.name is string &&
          episode.name.size() > 0 &&
          episode.name.size() <= 300 &&
          hasValidOptionalText(episode.stillPath));
    }

    function hasValidTvProgress(progress) {
      return progress == null ||
        (progress is map &&
          progress.keys().hasAll([
            'resumeEpisode',
            'updatedAt',
            'watchedEpisodeKeys'
          ]) &&
          progress.keys().hasOnly([
            'resumeEpisode',
            'updatedAt',
            'watchedEpisodeKeys'
          ]) &&
          progress.updatedAt is string &&
          progress.watchedEpisodeKeys is list &&
          progress.watchedEpisodeKeys.size() > 0 &&
          progress.watchedEpisodeKeys.size() <= 2000 &&
          hasValidResumeEpisode(progress.resumeEpisode));
    }

    function hasValidLibraryRecord() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'backdropPath',
          'id',
          'isFavorite',
          'isWatched',
          'mediaType',
          'overview',
          'posterPath',
          'releaseYear',
          'savedAt',
          'title',
          'updatedAt',
          'userRating'
        ]) &&
        data.keys().hasOnly([
          'backdropPath',
          'id',
          'isFavorite',
          'isWatched',
          'mediaType',
          'overview',
          'posterPath',
          'releaseYear',
          'savedAt',
          'title',
          'tvProgress',
          'updatedAt',
          'userRating'
        ]) &&
        data.id is int &&
        data.id > 0 &&
        (data.mediaType == 'movie' || data.mediaType == 'tv') &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 300 &&
        data.isFavorite is bool &&
        data.isWatched is bool &&
        data.savedAt is string &&
        data.updatedAt is string &&
        hasValidOptionalText(data.backdropPath) &&
        hasValidOptionalText(data.overview) &&
        hasValidOptionalText(data.posterPath) &&
        hasValidOptionalText(data.releaseYear) &&
        (!data.keys().hasAny(['tvProgress']) ||
          (hasValidTvProgress(data.tvProgress) &&
            (data.tvProgress == null ||
              data.mediaType == 'tv'))) &&
        (data.userRating == null ||
          (data.userRating is int &&
            data.userRating >= 1 &&
            data.userRating <= 10));
    }

    function hasValidDiscoveryPreferences() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'favoriteGenres',
          'preferredLanguage',
          'preferredMedia',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'favoriteGenres',
          'preferredLanguage',
          'preferredMedia',
          'updatedAt'
        ]) &&
        data.favoriteGenres is list &&
        data.favoriteGenres.size() <= 5 &&
        data.favoriteGenres.toSet().size() ==
          data.favoriteGenres.size() &&
        data.favoriteGenres.hasOnly([
          'action',
          'animation',
          'comedy',
          'crime',
          'documentary',
          'drama',
          'family',
          'fantasy',
          'history',
          'horror',
          'music',
          'mystery',
          'romance',
          'science-fiction',
          'thriller',
          'war',
          'western'
        ]) &&
        data.preferredLanguage in [
          'any',
          'de',
          'en',
          'es',
          'fr',
          'hi',
          'it',
          'ja',
          'ko',
          'ml',
          'pt',
          'si',
          'ta',
          'te',
          'zh'
        ] &&
        data.preferredMedia in [
          'balanced',
          'movie',
          'tv'
        ] &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 100;
    }

    function hasValidRecommendationFeedback() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'notInterestedRecordKeys',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'notInterestedRecordKeys',
          'updatedAt'
        ]) &&
        data.notInterestedRecordKeys is list &&
        data.notInterestedRecordKeys.size() <= 100 &&
        data.notInterestedRecordKeys.toSet().size() ==
          data.notInterestedRecordKeys.size() &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 100;
    }

    match /users/{userId}/library/{recordId} {
      allow read, delete: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId) &&
        hasValidLibraryRecord();
    }

    match /users/{userId}/preferences/{preferenceId} {
      allow read, delete: if ownsUserData(userId) &&
        preferenceId in ['discovery', 'recommendations'];
      allow create, update: if ownsUserData(userId) &&
        ((preferenceId == 'discovery' &&
            hasValidDiscoveryPreferences()) ||
          (preferenceId == 'recommendations' &&
            hasValidRecommendationFeedback()));
    }
  }
}
