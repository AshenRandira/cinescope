# Copy to .env.production for local production builds. Never commit the populated file.
VITE_FIREBASE_API_KEY=your_production_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-production-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-production-firebase-project-id
VITE_FIREBASE_APP_ID=your_production_firebase_web_app_id_here
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_production_recaptcha_enterprise_site_key_here
